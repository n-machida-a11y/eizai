      // 修正: 消費税区分マスタに基づいた計算ロジック
      function handleTaxCalculationA(e) {
        var select = document.getElementById('M-tax-type-select');
        var selectedOption = select.options[select.selectedIndex];
        var rate = selectedOption ? parseFloat(selectedOption.dataset.rate) : 0;
        
        // 修正: 念のための補正 (rateが1以上なら100で割る)
        if (rate >= 1) rate = rate / 100;
        
        var inc = parseFloat(document.getElementById('M-amount').value) || 0;
        var excInput = document.getElementById('M-amount-excluding-tax');
        
        // 税込から税抜を計算 (四捨五入の標準的な計算)
        if (rate > 0 && inc > 0) {
            var exc = Math.round(inc / (1 + rate));
            excInput.value = exc;
            document.getElementById('M-tax-excluded-display').textContent = formatNumber(exc);
        } else {
            excInput.value = inc;
            document.getElementById('M-tax-excluded-display').textContent = formatNumber(inc);
        }
        
        checkExpenseLimitA();
      }

