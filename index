      // 修正: 画像のクライアント側圧縮処理 (高速化)
      function handleImageUploadA(event) {
        // 重要: ファイルが選択されたら、古いURLは即座にクリアする
        document.getElementById('M-receiptUrl').value = '';

        var file = event.target.files[0];
        if (!file) return;

        // PDFの場合は圧縮せずそのまま送信
        if (file.type === 'application/pdf') {
            uploadToGas(file, file.name, false);
            return;
        }

        // 画像の場合はCanvasでリサイズ・圧縮
        var reader = new FileReader();
        reader.readAsDataURL(file);
        reader.onload = function(e) {
            var img = new Image();
            img.src = e.target.result;
            img.onload = function() {
                var maxWidth = 1024; // 最大幅を1024pxに制限
                var maxHeight = 1024;
                var width = img.width;
                var height = img.height;

                if (width > height) {
                    if (width > maxWidth) {
                        height *= maxWidth / width;
                        width = maxWidth;
                    }
                } else {
                    if (height > maxHeight) {
                        width *= maxHeight / height;
                        height = maxHeight;
                    }
                }

                var canvas = document.createElement('canvas');
                canvas.width = width;
                canvas.height = height;
                var ctx = canvas.getContext('2d');
                ctx.drawImage(img, 0, 0, width, height);

                // JPEG, 品質0.7で圧縮
                var compressedDataUrl = canvas.toDataURL('image/jpeg', 0.7);
                var newFileName = file.name.replace(/\.[^/.]+$/, "") + ".jpg";
                
                uploadToGas(compressedDataUrl, newFileName, true);
            };
        };
      }

