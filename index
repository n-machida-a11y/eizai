      function compressActivities_(actObj) {
        var arr = []; var cur = null;
        for (var i = 0; i < TIME_SLOTS.length - 1; i++) {
          var s = TIME_SLOTS[i], e = TIME_SLOTS[i+1], a = actObj[s];
          if (!a || !a.type) { if (cur) { arr.push(cur); cur=null; } continue; }
          
          var contentStr = (a.place ? '【' + a.place + '】 ' : '') + (a.detail || '');
          
          if (!cur) { cur = { startTime: s, endTime: e, type: a.type, content: contentStr }; continue; }
          if (cur.type === a.type && cur.content === contentStr) cur.endTime = e;
          else { arr.push(cur); cur = { startTime: s, endTime: e, type: a.type, content: contentStr }; }
        }
        if (cur) arr.push(cur);
        return arr;
      }

